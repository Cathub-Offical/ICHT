page {
  background-color: #f6f7fb;
  background-image:
    radial-gradient(980rpx 560rpx at 18% 8%, rgba(56, 189, 248, 0.20), rgba(56, 189, 248, 0) 62%),
    radial-gradient(760rpx 520rpx at 88% 6%, rgba(250, 204, 21, 0.14), rgba(250, 204, 21, 0) 58%),
    radial-gradient(860rpx 520rpx at 52% 0%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%),
    linear-gradient(180deg, #e0f2fe 0%, #f0f9ff 34%, #ffffff 100%);
  background-repeat: no-repeat;
  color: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "PingFang SC", "Hiragino Sans GB", "Microsoft Yahei", sans-serif;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 40, 0.08);
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #5f6368;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  background: #eef2ff;
  color: #3b5bdb;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.list-item:last-child {
  border-bottom: none;
}

.list-arrow {
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
}

.user-search-card {
  background: transparent;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  box-shadow: none;
  margin-bottom: 24rpx;
}

.user-search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  gap: 12rpx;
  margin: 0 -20rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.user-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  height: 72rpx;
  line-height: 72rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 8rpx;
  line-height: 1;
}

.primary-btn {
  background: #3b5bdb;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
}

/* ── 老人模式 ── */
.elder-mode .title       { font-size: 44rpx !important; }
.elder-mode .subtitle    { font-size: 34rpx !important; }
.elder-mode .tag         { font-size: 30rpx !important; }
.elder-mode .label       { font-size: 30rpx !important; }
.elder-mode .input,
.elder-mode .textarea    { font-size: 32rpx !important; }
.elder-mode .primary-btn,
.elder-mode .secondary-btn { font-size: 32rpx !important; padding: 24rpx 0 !important; }
.elder-mode .list-item   { font-size: 32rpx !important; padding: 22rpx 0 !important; }
.elder-mode .order-no    { font-size: 30rpx !important; }
