@import "../../app.wxss";

.manage-tip {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.query-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.query-input {
  flex: 1;
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  background: #f8fafc;
  font-size: 24rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.query-btn {
  min-width: 106rpx;
  border-radius: 12rpx;
  padding: 18rpx 0;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
  text-align: center;
}

.query-btn.reset {
  background: #fff1f1;
  color: #dc2626;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.form-field {
  margin-top: 16rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.form-input,
.picker-input {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f8fafc;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #1f2937;
  display: flex;
  align-items: center;
}

.form-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.form-actions .primary-btn,
.form-actions .secondary-btn {
  background: #f3f4f6;
  color: #374151;
  flex: 1;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
}

.form-actions .secondary-btn {
  background: #fff1f1;
  color: #dc2626;
}

.list-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 700;
}

.swipe-row {
  overflow: hidden;
  position: relative;
}

.swipe-inner {
  display: flex;
  flex-direction: row;
  transition: transform 0.22s ease;
  will-change: transform;
}

.swipe-inner.open {
  transform: translateX(-26.67vw);
}

.user-item {
  flex: 0 0 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #eef2f7;
  box-sizing: border-box;
}

.swipe-row:last-child .user-item {
  border-bottom: none;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #191970 0%, #4169E1 50%, #6495ED 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-img-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-initial {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.user-account {
  font-size: 24rpx;
  color: #334155;
  margin-bottom: 4rpx;
}

.user-meta {
  font-size: 22rpx;
  color: #9ca3af;
}

.user-regtime {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
  align-self: flex-start;
  padding-top: 4rpx;
}

.swipe-actions {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
}

.swipe-btn {
  width: 13.33vw;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.swipe-edit {
  background: #3b5bdb;
}

.swipe-delete {
  background: #ef4444;
}
