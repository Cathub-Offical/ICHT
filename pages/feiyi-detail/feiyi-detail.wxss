@import "../../app.wxss";

.detail-card {
  border: 1rpx solid #dbeafe;
  background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(59, 91, 219, 0.08);
}

.detail-image {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  background: #f0f1f3;
}

.meta-row {
  margin-top: 10rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
}

.meta-label {
  color: #64748b;
}

.meta-value {
  color: #1f2937;
  font-weight: 500;
}

.section-title {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.model-wrapper {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef1fa;
  margin-top: 8rpx;
}

.model-frame {
  display: block;
}

.model-loading,
.model-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.model-loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.model-error-text {
  font-size: 24rpx;
  color: #ef4444;
}
