@import "../../app.wxss";

.favorite-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.favorite-item:last-child {
  border-bottom: none;
}

.favorite-image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.favorite-body {
  flex: 1;
  min-width: 0;
}

.favorite-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.favorite-meta {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.fav-swipe-row {
  overflow: hidden;
}

.fav-swipe-inner {
  display: flex;
  flex-direction: row;
  transition: transform 0.22s ease;
}

.fav-swipe-inner.open {
  transform: translateX(-160rpx);
}

.fav-swipe-inner .favorite-item {
  width: 100%;
  flex-shrink: 0;
}

.fav-swipe-del {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ef4444;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}