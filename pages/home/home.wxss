@import "../../app.wxss";

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.stat-swiper {
  height: 260rpx;
  margin-bottom: 24rpx;
}

.stat-swiper .wx-swiper-dots{
  display:none !important;
}

.pie-canvas {
  width: 320px;
  height: 220px;
  margin: 0 auto;
  display: block; 
}

.c-pending {
  color:#6fa0cc;
}
.c-shipping {
  color:#f59e0b;
}
.c-finished{
  color:#3f3f46;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}


.stats-grid.single {
  grid-template-columns: 1fr;
}

.stat-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.primary-btn {
  background: #f3f4f6;
  border: 1rpx solid #d1d5db;
  color: #374151;            
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}
