page {
  min-height: 100%;
}

.ai-page {
  width: 100%;
}

.msg-list {
  width: 100%;
  box-sizing: border-box;
}

.msg-list-inner {
  padding: 24rpx 20rpx 160rpx;
}

/* ── message rows ── */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  gap: 14rpx;
}

.ai-row {
  flex-direction: row;
}

.user-row {
  flex-direction: row-reverse;
}

/* ── avatars ── */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.ai-avatar {
  background: rgb(252, 241, 255);
  border: 2rpx solid rgba(208, 99, 241, 0.25);
}

.avatar-ai-icon{
  width: 55rpx;
  height: 55rpx;
}

.avatar-ai-text {
  font-size: 38rpx;
  line-height: 1;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.user-avatar {
  background: #a564d8;
}

.avatar-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ── bubbles ── */
.bubble {
  max-width: 66%;
  border-radius: 24rpx;
  padding: 20rpx 24rpx 12rpx;
}

.ai-bubble {
  background: rgba(255, 255, 255, 0.92);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 16rpx rgba(99, 102, 241, 0.1);
}

.user-bubble {
  background: #a564d8;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 2rpx 16rpx rgba(79, 70, 229, 0.35);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  display: block;
  word-break: break-all;
}

.ai-bubble .bubble-text {
  color: #1f2937;
}

.user-bubble .bubble-text {
  color: #ffffff;
}

.bubble-time {
  font-size: 20rpx;
  display: block;
  margin-top: 8rpx;
}

.ai-bubble .bubble-time {
  color: #9ca3af;
}

.user-bubble .bubble-time {
  color: rgba(255, 255, 255, 0.55);
  text-align: right;
}

/* ── typing dots ── */
.typing-bubble {
  padding: 24rpx 28rpx;
}

.dot-wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #6b7280;
  animation: dot-bounce 1.2s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40%           { transform: scale(1);   opacity: 1; }
}

/* ── input bar ── */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(141, 140, 143, 0.25);
  box-sizing: border-box;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 24rpx;
}

.input-bar-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

.input-wrap {
  flex: 1;
  background: #f8fafc;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  height: 76rpx;
  line-height: 76rpx;
}

.cancel-reply-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgb(255, 255, 255);
  border: 1rpx solid #d1d5db;
  flex-shrink: 0;
  align-self: center;
}

.cancel-reply-icon {
  width: 36rpx;
  height: 36rpx;
}

.input-clear {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 0 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

.send-btn {
  background: #a564d8;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  opacity: 0.35;
  transition: opacity 0.3s ease;
}

.send-btn.active {
  opacity: 1;
}

.send-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
