@import "../../app.wxss";

.settings-card {
  padding: 0;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  filter: brightness(0.85) contrast(0.9) grayscale(0.9) opacity(0.95);
}

.item-label {
  font-size: 28rpx;
  color: #1f2937;
}

.divider-line {
  height: 1rpx;
  background: #f0f1f3;
  margin: 0 28rpx;
}

.elder-item {
  padding: 28rpx;
}

.item-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
