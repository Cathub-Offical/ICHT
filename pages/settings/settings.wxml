<glass-nav title="系统设置" />

<view class="container">
  <view class="card settings-card">
    <view class="list-item elder-item">
      <view class="item-left">
        <image class="item-icon" src="/assets/icons/elder.svg" mode="aspectFit" />
        <view>
          <text class="item-label">老人模式</text>
          <text class="item-desc">适当放大全局字体</text>
        </view>
      </view>
      <switch checked="{{elderMode}}" bindchange="onElderModeChange" color="#3b5bdb" />
    </view>
    <view class="divider-line"></view>
    <view class="list-item" bindtap="onClearCache">
      <view class="item-left">
        <image class="item-icon" src="/assets/icons/cache.svg" mode="aspectFit" />
        <text class="item-label">清除缓存</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="divider-line"></view>
    <view class="list-item" bindtap="onAbout">
      <view class="item-left">
        <image class="item-icon" src="/assets/icons/info.svg" mode="aspectFit" />
        <text class="item-label">关于本应用</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>
</view>
